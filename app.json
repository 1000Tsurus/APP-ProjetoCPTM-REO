{
  "expo": {
    "name": "app-scaner",
    "slug": "app-scaner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "appscaner",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permitir que o aplicativo CPTM use Face ID para validar o acesso operacional."
        }
      ],
      "expo-secure-store"
      ,[
        "expo-camera",
        { "cameraPermission": "Permitir que o RailLog Inspect capture fotografias das inspeções de dormentes.", "recordAudioAndroid": false }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
